# Environment variables for PeoplePay360 Backend
PORT=5000
NODE_ENV=development

# Database (Neon PostgreSQL connection string)
DATABASE_URL="postgresql://username:password@ep-sample-pooler.us-east-2.aws.neon.tech/peoplepay360?sslmode=require"

# JWT Secret for Session & Tokens
JWT_SECRET="peoplepay360-hackathon-jwt-secret-key-2026"
JWT_EXPIRES_IN="7d"

# Frontend URL for CORS
FRONTEND_URL="http://localhost:5173"

# Email Configuration (Nodemailer - Local/Ethereal or SMTP)
SMTP_HOST="smtp.ethereal.email"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="PeoplePay360 HR <no-reply@peoplepay360.com>"
